            <path android:fillColor="#F48FB1" android:alpha="0.5"
                android:pathData="M35,55 C20,40 8,55 18,68 C10,72 15,85 28,80 C30,90 42,92 48,82 C55,90 68,86 65,74 C75,72 75,58 64,56 C65,44 52,38 45,48 C40,38 27,36 35,55 Z" />
