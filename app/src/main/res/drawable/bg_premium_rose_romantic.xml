<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient: deep rose → blush pink → warm ivory -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="150"
                android:startColor="#FCE4EC"
                android:centerColor="#F8BBD0"
                android:endColor="#FFF0F4" />
        </shape>
    </item>

    <!-- Soft radial blush glow from upper-left -->
    <item android:right="200dp" android:bottom="500dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="100%p"
                android:startColor="#30F48FB1"
                android:endColor="#00F48FB1" />
        </shape>
    </item>

    <!-- Romantic rose illustration overlay -->
    <item>
