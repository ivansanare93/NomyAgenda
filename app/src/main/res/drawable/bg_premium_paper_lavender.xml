<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient: warm lavender paper -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#F5EEF8"
                android:centerColor="#EDE0F5"
                android:endColor="#E8D5F0" />
        </shape>
    </item>

    <!-- Subtle radial vignette overlay for depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="120%p"
                android:startColor="#00000000"
                android:endColor="#18B39DBC" />
        </shape>
    </item>

