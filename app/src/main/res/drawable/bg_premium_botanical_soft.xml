<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient: soft sage-cream background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="160"
                android:startColor="#F0F7EE"
                android:centerColor="#E8F5E3"
                android:endColor="#EFF7EA" />
        </shape>
    </item>

    <!-- Soft radial warm center glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="80%p"
                android:startColor="#18FFFFFF"
                android:endColor="#00E8F5E3" />
        </shape>
    </item>

