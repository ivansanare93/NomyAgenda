<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base warm sepia gradient (aged paper) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="150"
                android:startColor="#F5ECD7"
                android:centerColor="#EFE0C2"
                android:endColor="#E8D5B0" />
        </shape>
    </item>

    <!-- Top-left corner dark vignette (aged look) -->
    <item android:right="270dp" android:bottom="540dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="100%p"
                android:startColor="#30A0784A"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Bottom-right corner dark vignette -->
    <item android:left="270dp" android:top="540dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="100%p"
                android:startColor="#28A0784A"
                android:endColor="#00000000" />
        </shape>
    </item>

